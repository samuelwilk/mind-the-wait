{# Vehicle indicators - horizontally scrollable pills showing active vehicles #}
{# Updates in real-time via Mercure using Symfony's built-in turbo_stream_listen #}

{# turbo_stream_listen() outputs data attributes for the Mercure Stimulus controller #}
<div id="vehicle-indicators" class="mb-8" {{ turbo_stream_listen('route/' ~ routeId) }}>
    {# Vehicle pills - Turbo Stream updates will replace the element with matching ID #}
    {% include 'components/_vehicle_pills.html.twig' with {
        routeId: routeId,
        vehicles: vehicles
    } only %}
</div>
