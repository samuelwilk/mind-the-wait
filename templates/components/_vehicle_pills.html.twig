{# Vehicle pills container - for Turbo Stream updates #}
{# This partial is rendered by MercureRouteBroadcaster to update pills without replacing the controller #}

{% set nowTs = 'now'|date('U') %}

<div id="vehicle-pills-{{ routeId }}" class="relative">
    {% if vehicles is empty %}
        <p class="text-sm text-gray-500 italic">No active vehicles</p>
    {% else %}
        <div class="flex gap-2 overflow-x-auto pb-2 scrollbar-thin scrollbar-thumb-gray-300 scrollbar-track-transparent">
            {% for vehicle in vehicles %}
                {% set etaSeconds = vehicle.nextArrival ? vehicle.nextArrival.arrivalInSec(nowTs) : null %}
                {% set etaMinutes = vehicle.getEtaMinutes() %}
                {% set displayId = vehicle.getDisplayId()|replace({'Bus ': ''}) %}

                {% if etaSeconds is not null and etaSeconds <= 30 %}
                    {# At stop - green #}
                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-success-700 bg-success-100 border border-success-200 rounded-full whitespace-nowrap flex-shrink-0"
                          data-vehicle-id="{{ vehicle.vehicleId }}">
                        <span class="font-semibold">{{ displayId }}</span>
                        <span class="text-success-500">·</span>
                        At {{ vehicle.getNextStopName() }}
                    </span>
                {% elseif etaMinutes is not null %}
                    {# Approaching - blue #}
                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-primary-700 bg-primary-50 border border-primary-200 rounded-full whitespace-nowrap flex-shrink-0"
                          data-vehicle-id="{{ vehicle.vehicleId }}">
                        <span class="font-semibold">{{ displayId }}</span>
                        <span class="text-primary-400">·</span>
                        {{ etaMinutes }} min to {{ vehicle.getNextStopName() }}
                    </span>
                {% else %}
                    {# No prediction - gray #}
                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-gray-600 bg-gray-100 border border-gray-200 rounded-full whitespace-nowrap flex-shrink-0"
                          data-vehicle-id="{{ vehicle.vehicleId }}">
                        <span class="font-semibold">{{ displayId }}</span>
                        <span class="text-gray-400">·</span>
                        In transit
                    </span>
                {% endif %}
            {% endfor %}
        </div>

        {# Scroll fade indicator #}
        <div class="absolute right-0 top-0 bottom-2 w-8 bg-gradient-to-l from-white to-transparent pointer-events-none"></div>
    {% endif %}
</div>
